{
    "name": "saccharine/operations",
    "description": "Domain-agnostic case, facility, and stakeholder operations engine.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Saccharine\\Operations\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Saccharine\\Operations\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Saccharine\\Operations\\OperationsServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0 || ^13.0",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.1",
        "pestphp/pest": "^4.7",
        "pestphp/pest-plugin-laravel": "^4.1"
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench workbench:install --ansi --no-interaction --no-devtool",
        "test": "@php vendor/bin/pest --colors=always",
        "serve": "@php vendor/bin/testbench workbench:serve --ansi"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}